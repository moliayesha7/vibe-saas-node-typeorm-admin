{
  "name": "saas-node-admin-backend",
  "version": "2.0.0",
  "description": "Enterprise SaaS Backend — TypeScript, TypeORM, Express, Swagger",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node -r ./dist/tsconfig-paths-bootstrap.js dist/server.js",
    "typeorm:cli": "ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm:cli -- migration:run -d src/config/data-source.cli.ts",
    "migration:revert": "npm run typeorm:cli -- migration:revert -d src/config/data-source.cli.ts",
    "migration:generate": "npm run typeorm:cli -- migration:generate -d src/config/data-source.cli.ts",
    "migration:show": "npm run typeorm:cli -- migration:show -d src/config/data-source.cli.ts",
    "test": "jest --config jest.config.ts --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --config jest.config.ts --coverage --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typeorm": "^0.3.20",
    "reflect-metadata": "^0.2.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "socket.io": "^4.6.1",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "nodemailer": "^6.9.7",
    "cloudinary": "^1.41.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "axios": "^1.6.2",
    "express-async-errors": "^3.1.1",
    "node-cache": "^5.1.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/nodemailer": "^6.4.14",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/morgan": "^1.9.9"
  }
}
